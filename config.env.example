# ═══════════════════════════════════════════════════════════════
#  STOCKLINE — Variables d'environnement
#  Copier ce fichier en `config.env` et remplir les valeurs.
#  `config.env` ne doit JAMAIS etre commite (voir .gitignore).
# ═══════════════════════════════════════════════════════════════

# ─── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=8080
API_PREFIX=/api/v1
PUBLIC_URL=http://localhost:4000

# Origines autorisees a appeler l'API (frontend), separees par des virgules
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ─── MongoDB Atlas ─────────────────────────────────────────────
# Atlas > Database > Connect > Drivers > Node.js
# Ne pas oublier /stockline avant le "?"
MONGO_URI=mongodb+srv://stockline_app:MOT_DE_PASSE@cluster0.xxxxx.mongodb.net/stockline?retryWrites=true&w=majority
MONGO_POOL_SIZE=20

# ─── Redis (compteurs d'usage, rate limiting, temps reel) ──────
REDIS_URL=redis://localhost:6379

# ─── Securite JWT ──────────────────────────────────────────────
# Generer avec : openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_MOI
JWT_REFRESH_SECRET=CHANGE_MOI_AUSSI
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── Emails transactionnels (SMTP Brevo) ───────────────────────
# Laisser vide en dev : les emails s'affichent dans la console
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Stockline <noreply@stockline.cg>"
SUPPORT_EMAIL=support@stockline.cg

# ─── Cloudinary (photos produits / logos boutiques) ────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Passerelle de paiement active ──────────────────────────────
# Valeurs : geniuspay | feexpay
PAYMENT_PROVIDER=geniuspay

# ─── Genius Pay ─────────────────────────────────────────────────
GENIUSPAY_API_KEY=
GENIUSPAY_MERCHANT_ID=
GENIUSPAY_BASE_URL=https://api.geniuspay.cg
GENIUSPAY_CALLBACK_URL=https://api.stockline.cg/api/v1/public/payments/callback
# Secret de signature des notifications (si Genius Pay en fournit un)
GENIUSPAY_WEBHOOK_SECRET=

# ─── FeexPay (passerelle de repli) ──────────────────────────────
FEEXPAY_API_KEY=
FEEXPAY_SHOP_ID=
FEEXPAY_BASE_URL=https://api-v2.feexpay.me

# ─── Parametres regionaux par defaut ───────────────────────────
DEFAULT_CURRENCY=XAF
DEFAULT_TIMEZONE=Africa/Brazzaville
DEFAULT_COUNTRY=Congo

# ─── Compte Super-Admin initial (script npm run seed) ──────────
SEED_SUPERADMIN_NOM=Ethane Nathan Bokinga
SEED_SUPERADMIN_EMAIL=admin@stockline.cg
SEED_SUPERADMIN_PASSWORD=ChangeMoi2026!
